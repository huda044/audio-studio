# Audio Studio (mode upload-only, tanpa login) — contoh env server.
PORT=4000

# Folder upload sementara (opsional). Default: ../uploads atau temp OS.
UPLOADS_DIR=

# Batas & performa
MAX_UPLOAD_MB=250
INLINE_AUDIO_LIMIT_MB=8
APP_MAX_DURATION_SECONDS=200
JSON_LIMIT=512kb
PROCESS_RATE_LIMIT=30
INFO_RATE_LIMIT=60
CONVERSION_CONCURRENCY=2
CONVERSION_QUEUE_LIMIT=20
FFMPEG_TIMEOUT_MS=300000

# Roblox Open Cloud upload
ROBLOX_AUDIO_MAX_DURATION_SECONDS=420
ROBLOX_AUDIO_MAX_BYTES=19922944
ROBLOX_UPLOAD_TIMEOUT_MS=60000
ROBLOX_POLL_TIMEOUT_MS=240000
ROBLOX_POLL_INTERVAL_MS=2500
ROBLOX_UPLOAD_CONCURRENCY=1
ROBLOX_UPLOAD_QUEUE_LIMIT=15

# Saat menyajikan frontend hasil build dari Express (produksi/Docker):
# CLIENT_DIST=/app/client/dist
CLIENT_DIST=

# Tampilkan detail error 5xx ke client (debug saja)
EXPOSE_ERROR_DETAILS=false
