# Audio Studio (mode upload-only, tanpa login) — contoh env server.
PORT=4000

# Model AI (API kompatibel dengan OpenAI Chat Completions)
# Contoh base URL: https://openrouter.ai/api/v1 atau https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=60000
AI_STREAM_TIMEOUT_MS=300000
AI_RATE_LIMIT=20
# Opsional, terutama untuk OpenRouter
AI_HTTP_REFERER=
AI_APP_NAME=Audio Studio

# Folder upload sementara (opsional). Default: ../uploads atau temp OS.
UPLOADS_DIR=

# Format & kualitas audio hasil konversi.
# mp3 (default) = LAME VBR ~V2, encoder terbaik untuk Roblox + kompatibel di mana saja.
# ogg = libvorbis 160k (legacy, hasil lebih kecil tapi kualitas lebih rendah).
AUDIO_FORMAT=mp3
# Time-stretch default memakai rubberband (formant dipertahankan → vokal tidak
# rusak saat dipercepat). Set true untuk kembali ke atempo bawaan ffmpeg.
DISABLE_RUBBERBAND=false
# Set true untuk melewati loudnorm (normalize loudness) — mempercepat konversi
# pada sumber yang levelnya sudah rata.
DISABLE_LOUDNORM=false
# Set true untuk mematikan pipeline fallback otomatis (normalize/reverb gagal → minimal).
DISABLE_AUDIO_FALLBACK=false

# Keamanan: bila diisi (comma-separated), hanya origin ini yang boleh memanggil API.
# Contoh: ALLOWED_ORIGINS=https://lucivoid-audio-studio.vercel.app
# Kosong = CORS terbuka (aman untuk mode tanpa login karena API key dikirim per-request).
ALLOWED_ORIGINS=

# Logging & runtime
LOG_LEVEL=info
NODE_ENV=production
# Batas waktu drain koneksi saat shutdown (ms).
SHUTDOWN_TIMEOUT_MS=10000

# Batas & performa
MAX_UPLOAD_MB=250

# Audio hasil konversi dikirim sebagai base64 DI DALAM JSON, atau lewat audioUrl
# (/api/files/...). Default 0 = base64 dimatikan: audio diambil client lewat
# audioUrl. Base64 membengkakkan respons +33% dan respons besar rawan terputus di
# tengah lewat tunnel/proxy — gejalanya "Failed to fetch" padahal konversi sukses.
# Set nilai >0 hanya bila ingin audio tertanam di respons (mis. pemakaian offline).
INLINE_AUDIO_TOTAL_LIMIT_MB=0
# Batas per-part; hanya berlaku bila budget total di atas > 0.
INLINE_AUDIO_LIMIT_MB=0

# Bila diisi, /metrics hanya bisa diakses dengan X-Metrics-Token (atau Bearer token).
METRICS_TOKEN=
APP_MAX_DURATION_SECONDS=200
JSON_LIMIT=512kb
# Rate limit (per jendela waktu yang tertera di kode):
#   PROCESS_RATE_LIMIT  30 request / 30 menit
#   UPLOAD_RATE_LIMIT   60 request / 30 menit
#   INFO_RATE_LIMIT     60 request / 1 menit
#   DELETE_RATE_LIMIT   60 request / 1 menit
#   STATS_RATE_LIMIT    20 request / 1 menit
#   PROGRESS_RATE_LIMIT 300 request / 1 menit (polling progres konversi)
PROCESS_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=60
INFO_RATE_LIMIT=60
DELETE_RATE_LIMIT=60
STATS_RATE_LIMIT=20
PROGRESS_RATE_LIMIT=300
# Berapa lama progres konversi disimpan untuk polling (ms, minimal 60000).
PROGRESS_TTL_MS=900000
CONVERSION_CONCURRENCY=2
CONVERSION_QUEUE_LIMIT=20
# Plafon durasi (detik): master output maks 4 jam, sumber YouTube maks 3 jam,
# timeout encode ffmpeg 30 menit untuk mengakomodasi sumber berjam-jam.
MAX_OUTPUT_SECONDS=14400
FFMPEG_TIMEOUT_MS=1800000

# Roblox Open Cloud upload
ROBLOX_AUDIO_MAX_DURATION_SECONDS=420
ROBLOX_AUDIO_MAX_BYTES=19922944
ROBLOX_UPLOAD_TIMEOUT_MS=60000
ROBLOX_POLL_TIMEOUT_MS=240000
ROBLOX_POLL_INTERVAL_MS=2500
ROBLOX_UPLOAD_CONCURRENCY=1
ROBLOX_UPLOAD_QUEUE_LIMIT=15

# Smart split: potong audio di jeda hening (bukan persis detik ke-N).
# Matikan dengan DISABLE_SMART_SPLIT=true bila ingin potongan persis kelipatan durasi.
DISABLE_SMART_SPLIT=false
SMART_SILENCE_NOISE_DB=-35
SMART_SILENCE_MIN_D=0.5
SMART_SILENCE_TIMEOUT_MS=300000

# Import audio dari link YouTube (yt-dlp). Binary dicari di:
# YTDL_PATH -> server/bin/yt-dlp(.exe) -> PATH. Gratis, tanpa API key.
# yt-dlp_linux: https://github.com/yt-dlp/yt-dlp/releases
# Binary yang tua = penyebab gagal import yang paling umum (extractor YouTube
# berubah terus) — perbarui berkala lewat PERBARUI-YT-DLP.bat di root repo.
YTDL_PATH=
YTDL_TIMEOUT_MS=900000
YTDL_META_TIMEOUT_MS=120000
YTDL_MAX_DURATION_SECONDS=10800
# Jumlah fragmen audio yang diunduh paralel (yt-dlp default 1 = lambat).
YTDL_CONCURRENT_FRAGMENTS=8
YT_IMPORT_RATE_LIMIT=10

# Tolak konversi baru bila ruang kosong disk di folder uploads di bawah nilai ini (MB).
# Mencegah kegagalan samar akibat disk penuh di tengah proses. 0 = matikan pengecekan.
MIN_FREE_SPACE_MB=1024

# Sweep file sementara di folder uploads (upload mentah, sumber YouTube yt-*, master-*).
# Dijalankan saat boot, saat shutdown, dan berkala. Tanpa sapuan saat boot, sisa tiap
# sesi menumpuk tanpa batas (pernah terjadi: 1.2 GB tertinggal).
# UPLOAD_TTL_MS: umur maksimum file sebelum dihapus (default 3 jam).
# CLEANUP_INTERVAL_MS: jeda antar sapuan (default 10 menit).
UPLOAD_TTL_MS=10800000
CLEANUP_INTERVAL_MS=600000

# Saat menyajikan frontend hasil build dari Express (produksi/Docker):
# CLIENT_DIST=/app/client/dist
CLIENT_DIST=

# Tampilkan detail error 5xx ke client (debug saja)
EXPOSE_ERROR_DETAILS=false
