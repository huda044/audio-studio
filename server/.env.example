PORT=4000
# Pisahkan dengan koma untuk banyak domain, atau pakai * hanya jika memang public API.
CLIENT_ORIGIN=http://localhost:5173

# Auth & limit
JWT_SECRET=ganti-ke-string-random-panjang
JWT_EXPIRES_IN=365d
GOOGLE_CLIENT_ID=
# Discord OAuth (Authorization Code flow)
# Buat aplikasi di https://discord.com/developers/applications
# Tambahkan Redirect URI yang sama persis dengan DISCORD_REDIRECT_URI
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_SCOPES=identify email
# URL publik aplikasi, dipakai untuk redirect setelah login Discord (tanpa trailing slash).
APP_PUBLIC_URL=
# Master key untuk enkripsi credential server-side (AES-256-GCM).
# Generate dengan: node scripts/generate-master-key.mjs
# Wajib diisi sebelum user bisa simpan API key Roblox di server.
SECRETS_MASTER_KEY=

# Persistence akun/profile.
# Isi DATABASE_URL dari PostgreSQL/Neon/Supabase/Render DB agar akun, group,
# creator id, history, invoice, dan API key terenkripsi tidak reset saat deploy.
# Kalau kosong, backend memakai file JSON di DATA_DIR dan bisa hilang di hosting
# tanpa persistent disk.
DATABASE_URL=
POSTGRES_SSL=
DATA_STORE_NAMESPACE=audio-studio
DATA_STORE_TABLE=audio_studio_kv
DATA_DIR=./data
FREE_CONVERT_LIMIT=3
FREE_DURATION_LIMIT_SECONDS=600
PROCESS_RATE_LIMIT=12
INFO_RATE_LIMIT=45
CONVERSION_CONCURRENCY=2
CONVERSION_QUEUE_LIMIT=20
INLINE_AUDIO_LIMIT_MB=8
MAX_UPLOAD_MB=250
JSON_LIMIT=512kb
FFMPEG_TIMEOUT_MS=300000

# Admin account bootstrap
# Isi 3 env ini saat deploy untuk otomatis membuat/mengaktifkan akun admin.
# Setelah itu admin login lewat halaman login biasa, bukan ADMIN_SECRET.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ganti-password-admin-kuat
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# YouTube helper
# Kosongkan jika pakai installer otomatis server/bin/yt-dlp.
YTDLP_PATH=
YTDLP_FORCE_UPDATE=true
YTDLP_PREFER_LOCAL=
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_TEXT=
YTDLP_COOKIES_BASE64=
YOUTUBE_COOKIES_JSON=
YOUTUBE_COOKIES_TEXT=
YOUTUBE_COOKIES_BASE64=
YOUTUBE_COOKIE=
YOUTUBE_PROXY=
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
YOUTUBE_DATA_SYNC_ID=
YOUTUBE_PLAYER_SKIP=
YOUTUBE_PLAYER_CLIENT=
YOUTUBE_API_KEY=
YOUTUBE_DOWNLOAD_ORDER=direct-url,ytdl-core,yt-dlp
YTDLP_JS_RUNTIMES=
YTDLP_DISABLE_JS_RUNTIME=false
YTDLP_ALT_CLIENT_FALLBACKS=true
YTDLP_ENABLE_SECTIONS=true
YTDLP_FORCE_IPV4=true
YTDLP_LEGACY_SERVER_CONNECT=false
YTDLP_NO_CHECK_CERTIFICATES=false
YTDLP_SOCKET_TIMEOUT=15
YTDLP_RETRIES=2
YTDLP_FRAGMENT_RETRIES=2
YTDLP_EXTRACTOR_RETRIES=4
YTDLP_RETRY_SLEEP=extractor:linear=1::4
YTDLP_CONCURRENT_FRAGMENTS=1
YTDLP_GET_URL_TIMEOUT_MS=45000
YTDLP_SECTION_TIMEOUT_MS=120000
YTDLP_DOWNLOAD_TIMEOUT_MS=90000
YOUTUBE_DIRECT_DOWNLOAD_TIMEOUT_MS=60000
YTDL_CORE_DOWNLOAD_TIMEOUT_MS=60000
DISABLE_AUDIO_FALLBACK=false

# Roblox Open Cloud upload
ROBLOX_AUDIO_MAX_DURATION_SECONDS=420
ROBLOX_AUDIO_MAX_BYTES=19922944
ROBLOX_UPLOAD_TIMEOUT_MS=60000
ROBLOX_POLL_TIMEOUT_MS=240000
ROBLOX_POLL_INTERVAL_MS=2500
ROBLOX_UPLOAD_CONCURRENCY=1
ROBLOX_UPLOAD_QUEUE_LIMIT=15

# Email (kosong = mode dev code)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_DEV_CODES=true
APP_NAME=Audio Studio
APP_COLOR=#06b6d4

# Midtrans (Snap). Kosong = invoice manual.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false
