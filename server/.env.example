# Audio Studio (mode upload-only, tanpa login) — contoh env server.
PORT=4000

# Model AI (API kompatibel dengan OpenAI Chat Completions)
# Contoh base URL: https://openrouter.ai/api/v1 atau https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=60000
AI_RATE_LIMIT=20
# Opsional, terutama untuk OpenRouter
AI_HTTP_REFERER=
AI_APP_NAME=Audio Studio

# Folder upload sementara (opsional). Default: ../uploads atau temp OS.
UPLOADS_DIR=

# Batas & performa
MAX_UPLOAD_MB=250
INLINE_AUDIO_LIMIT_MB=8
# Batas TOTAL base64 yang di-inline dalam satu respons /api/process.
# Part di atas budget tetap bisa diakses lewat /api/files/.
INLINE_AUDIO_TOTAL_LIMIT_MB=16
# Bila diisi, /metrics hanya bisa diakses dengan X-Metrics-Token (atau Bearer token).
METRICS_TOKEN=
APP_MAX_DURATION_SECONDS=200
JSON_LIMIT=512kb
PROCESS_RATE_LIMIT=30
INFO_RATE_LIMIT=60
CONVERSION_CONCURRENCY=2
CONVERSION_QUEUE_LIMIT=20
FFMPEG_TIMEOUT_MS=300000

# Roblox Open Cloud upload
ROBLOX_AUDIO_MAX_DURATION_SECONDS=420
ROBLOX_AUDIO_MAX_BYTES=19922944
ROBLOX_UPLOAD_TIMEOUT_MS=60000
ROBLOX_POLL_TIMEOUT_MS=240000
ROBLOX_POLL_INTERVAL_MS=2500
ROBLOX_UPLOAD_CONCURRENCY=1
ROBLOX_UPLOAD_QUEUE_LIMIT=15

# Import audio dari link YouTube (yt-dlp). Binary dicari di:
# YTDL_PATH -> server/bin/yt-dlp(.exe) -> PATH. Gratis, tanpa API key.
# yt-dlp_linux: https://github.com/yt-dlp/yt-dlp/releases
YTDL_PATH=
YTDL_TIMEOUT_MS=300000
YTDL_MAX_DURATION_SECONDS=3600
YT_IMPORT_RATE_LIMIT=10

# Saat menyajikan frontend hasil build dari Express (produksi/Docker):
# CLIENT_DIST=/app/client/dist
CLIENT_DIST=

# Tampilkan detail error 5xx ke client (debug saja)
EXPOSE_ERROR_DETAILS=false
