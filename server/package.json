{
  "name": "audio-studio-server",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
