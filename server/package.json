    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "multer": "^2.1.1",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.8.3",
    "vitest": "^4.1.9"
