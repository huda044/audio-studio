NODE_ENV=production
PORT=7860
CLIENT_DIST=/app/client/dist
CLIENT_ORIGIN=*
APP_PUBLIC_URL=http://YOUR_ORACLE_PUBLIC_IP:7860

MAX_UPLOAD_MB=250
INLINE_AUDIO_LIMIT_MB=8
DATA_DIR=/data

# Strongly recommended: keep using your existing PostgreSQL DATABASE_URL.
# If empty, data is stored in ./data on the VPS volume.
DATABASE_URL=
POSTGRES_SSL=
DATA_STORE_NAMESPACE=audio-studio
DATA_STORE_TABLE=audio_studio_kv

# Required for login/API key encryption. Keep these stable forever.
JWT_SECRET=CHANGE_TO_RANDOM_HEX
SECRETS_MASTER_KEY=CHANGE_TO_GENERATED_MASTER_KEY

# Admin bootstrap. Set once, then you can leave these empty after admin is created.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ADMIN_PASSWORD
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

EMAIL_DEV_CODES=true
PROCESS_RATE_LIMIT=12
INFO_RATE_LIMIT=45
CONVERSION_CONCURRENCY=1
CONVERSION_QUEUE_LIMIT=10
JSON_LIMIT=512kb

# YouTube / yt-dlp / PO token provider
YTDLP_FORCE_UPDATE=true
YTDLP_PREFER_LOCAL=true
YTDLP_STARTUP_UPDATE=true
YTDLP_PATH=/usr/local/bin/yt-dlp-py
YTDLP_BGUTIL_PROVIDER=true
YTDLP_BGUTIL_PROVIDER_HOME=/opt/bgutil-ytdlp-pot-provider/server
YTDLP_BGUTIL_PROVIDER_URL=http://127.0.0.1:4416
YTDLP_BGUTIL_DISABLE_INNERTUBE=1
YTDLP_BGUTIL_WARMUP_TIMEOUT_MS=90000
YOUTUBE_PO_DOWNLOAD_ORDER=yt-dlp-section-mweb,yt-dlp-mweb,ytdl-core,direct-section-mweb,direct-url-mweb
YOUTUBE_PO_GET_URL_TIMEOUT_MS=45000
YTDLP_ENABLE_SECTIONS=true
YTDLP_ALT_CLIENT_FALLBACKS=true
YTDLP_FORCE_IPV4=true
YTDLP_LEGACY_SERVER_CONNECT=false
YTDLP_NO_CHECK_CERTIFICATES=false
YTDLP_SOCKET_TIMEOUT=15
YTDLP_RETRIES=2
YTDLP_FRAGMENT_RETRIES=2
YTDLP_EXTRACTOR_RETRIES=4
YTDLP_RETRY_SLEEP=extractor:linear=1::4
YTDLP_CONCURRENT_FRAGMENTS=1
YOUTUBE_DOWNLOAD_ORDER=direct-section,direct-url,ytdl-core,yt-dlp
YTDLP_GET_URL_TIMEOUT_MS=60000
YTDLP_SECTION_TIMEOUT_MS=60000
YTDLP_DOWNLOAD_TIMEOUT_MS=90000
YOUTUBE_DIRECT_SECTION_TIMEOUT_MS=120000
YOUTUBE_DIRECT_DOWNLOAD_TIMEOUT_MS=60000
YTDL_CORE_DOWNLOAD_TIMEOUT_MS=60000

# Paste cookies as secret text. Prefer base64 if your shell/editor breaks newlines.
YTDLP_COOKIES_TEXT=
YTDLP_COOKIES_BASE64=
YOUTUBE_PROXY=
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# Roblox Open Cloud upload
ROBLOX_AUDIO_MAX_DURATION_SECONDS=420
ROBLOX_AUDIO_MAX_BYTES=19922944
ROBLOX_UPLOAD_TIMEOUT_MS=60000
ROBLOX_POLL_TIMEOUT_MS=240000
ROBLOX_POLL_INTERVAL_MS=2500
ROBLOX_UPLOAD_CONCURRENCY=1
ROBLOX_UPLOAD_QUEUE_LIMIT=15

GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
APP_NAME=Audio Studio
APP_COLOR=#06b6d4

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false
