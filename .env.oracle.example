# Audio Studio — contoh env untuk self-host (Oracle Cloud / VPS) via Docker.
# Aplikasi berjalan mode upload-only: TANPA login, database, atau CMS.
# Salin file ini menjadi .env.oracle lalu isi nilai yang perlu.
# Referensi lengkap semua variabel: server/.env.example

NODE_ENV=production
PORT=7860
# Dilayani Express dari hasil build Vite (dibuat di dalam Dockerfile).
CLIENT_DIST=/app/client/dist
UPLOADS_DIR=/app/uploads

# Bila frontend di domain lain (mis. Vercel), batasi origin yang boleh memanggil API.
# Kosong = CORS terbuka (aman tanpa login karena API key Roblox dikirim per-request).
ALLOWED_ORIGINS=

# Format & kualitas audio hasil konversi
# mp3 (default) = LAME VBR ~V2 | ogg = libvorbis 160k (legacy)
AUDIO_FORMAT=mp3
DISABLE_RUBBERBAND=false
DISABLE_LOUDNORM=false

# Batas & performa
MAX_UPLOAD_MB=250
INLINE_AUDIO_LIMIT_MB=8
INLINE_AUDIO_TOTAL_LIMIT_MB=16
APP_MAX_DURATION_SECONDS=200
MAX_OUTPUT_SECONDS=14400
FFMPEG_TIMEOUT_MS=1800000
JSON_LIMIT=512kb
PROCESS_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=60
INFO_RATE_LIMIT=60
DELETE_RATE_LIMIT=60
STATS_RATE_LIMIT=20
PROGRESS_RATE_LIMIT=300
PROGRESS_TTL_MS=900000
CONVERSION_CONCURRENCY=2
CONVERSION_QUEUE_LIMIT=20
SHUTDOWN_TIMEOUT_MS=10000

# Smart split: potong audio di jeda hening, bukan persis detik ke-N.
DISABLE_SMART_SPLIT=false
SMART_SILENCE_NOISE_DB=-35
SMART_SILENCE_MIN_D=0.5
SMART_SILENCE_TIMEOUT_MS=300000

# YouTube / yt-dlp — binary dicari berurutan: YTDL_PATH -> server/bin/yt-dlp -> PATH.
# IP datacenter (VPS/Space) sering ditolak YouTube ("sign in to confirm you're not a bot");
# itu batasan lingkungan, bukan bug — pakai backend di PC sendiri untuk hasil paling andal.
YTDL_PATH=
YTDL_TIMEOUT_MS=900000
YTDL_META_TIMEOUT_MS=120000
YTDL_MAX_DURATION_SECONDS=10800
YTDL_CONCURRENT_FRAGMENTS=8
YT_IMPORT_RATE_LIMIT=10

# Tolak konversi baru bila ruang kosong disk di bawah nilai ini (MB). 0 = matikan.
MIN_FREE_SPACE_MB=1024

# Roblox Open Cloud upload
ROBLOX_AUDIO_MAX_DURATION_SECONDS=420
ROBLOX_AUDIO_MAX_BYTES=19922944
ROBLOX_UPLOAD_TIMEOUT_MS=60000
ROBLOX_POLL_TIMEOUT_MS=240000
ROBLOX_POLL_INTERVAL_MS=2500
ROBLOX_UPLOAD_CONCURRENCY=1
ROBLOX_UPLOAD_QUEUE_LIMIT=15

# Opsional: lindungi /metrics & /api/stats dengan token.
METRICS_TOKEN=
# Tampilkan detail error 5xx ke client (debug saja).
EXPOSE_ERROR_DETAILS=false
LOG_LEVEL=info

# Opsional: integrasi AI (kompatibel OpenAI Chat Completions), nonaktif bila kosong.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
